{
  "ci": {
    "collect": {
      "staticDistDir": "./out",
      "url": ["/"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.94 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.99 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci-report/mobile"
    }
  }
}
