{
  "name": "ask-my-cv-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "node scripts/sync-replays.mjs && next dev",
    "build": "node scripts/sync-archive.mjs && node scripts/sync-architecture.mjs && node scripts/sync-xops.mjs && node scripts/sync-cv.mjs && node scripts/sync-replays.mjs && next build && node scripts/csp.mjs",
    "pdf": "node scripts/cv-pdf.mjs",
    "history:sync": "node scripts/sync-archive.mjs && node scripts/sync-issues.mjs",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "next": "16.3.8",
    "next-intl": "4.14.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "basic-ftp": "^6.2.1"
  }
}
